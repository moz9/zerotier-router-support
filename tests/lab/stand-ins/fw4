#!/bin/sh
# Lab stand-in for fw4 (the real one needs nftables, which qemu cannot pass through): the checks succeed.
# With /tmp/lab/die-once present it plays "the installer was killed in the middle": it kills the running
# installer and the helper, once. The helper calls fw4 after the new files are already in place.
if [ -e /tmp/lab/die-once ]; then
	rm -f /tmp/lab/die-once
	echo "$(date +%H:%M:%S) installer killed in the middle" >> /tmp/lab/firewall-calls
	pkill -9 -f 'router-install.sh' 2>/dev/null
	pkill -9 -f 'zerotier-support/helper install' 2>/dev/null
	exit 1
fi
case "${1:-}" in print) echo 'table inet fw4 { }' ;; esac
exit 0
