#!/bin/sh /etc/rc.common
# Lab stand-in for a vendor firmware's ZeroTier start-up script. Written for the lab from the behaviour seen on a
# RouteRich router (OpenWrt 24.10, ZeroTier 1.14), not copied from it:
#   - one program per uci section of type "zerotier" with enabled=1, networks from that section's "list join";
#   - ZeroTier's home kept on flash (/etc/config/zero) and linked to /var/lib/zerotier-one at every start;
#   - no "-p" and no local_conf_path: ZeroTier reads only <home>/local.conf;
#   - no respawn: procd does not start the program again after it exits;
#   - "start" also runs the firmware's own firewall helper, which reloads the firewall;
#   - "stop" deletes the networks' settings in the home and reloads the firewall.
# Every step is written to /tmp/lab/vendor-init-calls.
START=99
USE_PROCD=1

VARLIB=/var/lib/zerotier-one

note() { echo "$(date +%H:%M:%S) $*" >> /tmp/lab/vendor-init-calls; }
join_one() { touch "$VARLIB/networks.d/$1.conf"; }

one_start() {
	local sec="$1" on secret config_path
	config_get_bool on "$sec" enabled 0
	[ "$on" = 1 ] || return 0
	# the home on flash, set as the vendor's script sets it (the app recognises such a script by this line)
	config_path=/etc/config/zero
	mkdir -p "$config_path"
	rm -rf "$VARLIB"
	ln -s "$config_path" "$VARLIB"
	mkdir -p "$VARLIB/networks.d"
	config_get secret "$sec" secret
	if [ -n "$secret" ]; then
		echo "$secret" > "$VARLIB/identity.secret"
		rm -f "$VARLIB/identity.public"
	fi
	config_list_foreach "$sec" join join_one
	note "start $sec"
	procd_open_instance
	procd_set_param command /usr/bin/zerotier-one "$VARLIB"
	procd_close_instance
}

start_service() {
	config_load zerotier
	config_foreach one_start zerotier
	fw4 reload
}

one_stop() {
	note "stop $1: the networks' settings deleted, the firewall reloaded"
	fw4 reload
	rm -f "$VARLIB"/networks.d/*.conf
	rm -rf "$VARLIB"
}

stop_service() {
	config_load zerotier
	config_foreach one_stop zerotier
}

reload_service() {
	stop
	start
}
