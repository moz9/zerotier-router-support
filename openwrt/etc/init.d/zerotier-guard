#!/bin/sh /etc/rc.common
# ZeroTier access guard: watches the ZeroTier daemon and repairs remote access by itself.
# Starts right after /etc/init.d/zerotier (START=90). procd restarts the guard itself without a limit.
# At shutdown the last known network settings are written to flash once more, if they changed.
# What it does and what it cannot do: /usr/libexec/zerotier-support/guard status

START=91
STOP=05
USE_PROCD=1

GUARD=/usr/libexec/zerotier-support/guard

start_service() {
	[ -x "$GUARD" ] || return 0
	procd_open_instance
	procd_set_param command "$GUARD" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	[ -x "$GUARD" ] || return 0
	"$GUARD" save >/dev/null 2>&1 || true
}
