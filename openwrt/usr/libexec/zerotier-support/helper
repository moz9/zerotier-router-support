#!/bin/sh
set -eu

NETWORK_SECTION="router_support"
FW_ZONE="zt_support"
FW_RULE="allow_zt_support_router"
ZT_PRIMARY_PORT="9993"
ZT_SECONDARY_PORT="25534"
ZT_TERTIARY_PORT="34923"
ZT_SUPPORT_LOCAL_CONF="/etc/zerotier-router-support.conf"
ZT_BYPASS_FILE="/etc/nftables.d/20-podkop-zerotier-bypass.nft"
ZT_LOCAL_CONF_TEMPLATE="/usr/libexec/zerotier-support/zerotier-router-support.conf"
ZT_BYPASS_TEMPLATE="/usr/libexec/zerotier-support/20-podkop-zerotier-bypass.nft"
ZT_UPGRADE_SNAPSHOT=""
ZT_UPGRADE_NETWORK_IDS=""
ZT_UPGRADE_WAS_READY="0"

merge_local_conf() {
	jq --arg warp "$2" --argjson secondary "$ZT_SECONDARY_PORT" --argjson tertiary "$ZT_TERTIARY_PORT" '
		if type != "object" or ((.settings // {}) | type) != "object" then error("Invalid local.conf") else . end |
		.settings = ((.settings // {}) + {secondaryPort: $secondary, tertiaryPort: $tertiary}) |
		if $warp == "" then . else
		  if ((.settings.interfacePrefixBlacklist // []) | type) != "array" then error("Invalid interface blacklist") else . end |
		  .settings.interfacePrefixBlacklist = ((.settings.interfacePrefixBlacklist // []) + [$warp] | unique)
		end' "$1"
}

is_hex16() {
	printf '%s' "$1" | grep -Eq '^[0-9a-fA-F]{16}$'
}

is_safe_target() {
	printf '%s' "$1" | grep -Eq '^[0-9A-Za-z:._/-]{1,128}$'
}

pm_install_zerotier() {
	if command -v zerotier-cli >/dev/null 2>&1; then
		echo "ZeroTier уже установлен."
		return 0
	fi

	if command -v apk >/dev/null 2>&1; then
		apk update || true
		apk add zerotier
		return $?
	fi

	if command -v opkg >/dev/null 2>&1; then
		opkg update
		opkg install zerotier
		return $?
	fi

	echo "Не найден поддерживаемый менеджер пакетов: нужен apk или opkg." >&2
	return 1
}

current_zerotier_ports() {
	if ! command -v zerotier-cli >/dev/null 2>&1 || ! command -v jsonfilter >/dev/null 2>&1; then
		return 0
	fi

	zt_json="$(zerotier-cli info -j 2>/dev/null || true)"
	[ -n "$zt_json" ] || return 0
	for expression in '@.config.settings.primaryPort' '@.config.settings.secondaryPort' '@.config.settings.tertiaryPort'; do
		printf '%s\n' "$zt_json" | jsonfilter -e "$expression" 2>/dev/null || true
	done
}

configured_network_ids() {
	uci show zerotier 2>/dev/null | sed -n "s/^zerotier\.[^.]*\.id='\([0-9A-Fa-f]\{16\}\)'$/\1/p"
}

networks_are_ready() {
	network_ids="${1:-}"
	[ -n "$network_ids" ] || return 1
	command -v jsonfilter >/dev/null 2>&1 || return 1
	network_json="$(zerotier-cli listnetworks -j 2>/dev/null || true)"
	[ -n "$network_json" ] || return 1
	for network_id in $network_ids; do
		network_status="$(printf '%s\n' "$network_json" | jsonfilter -e "@[@.id=\"${network_id}\"].status" 2>/dev/null || true)"
		[ "$network_status" = "OK" ] || return 1
	done
	return 0
}

transport_ports_are_fixed() {
	ports="$(current_zerotier_ports)"
	[ "$(printf '%s\n' "$ports" | grep -Ec '^[0-9]+$')" = 3 ] || return 1
	for expected_port in "$ZT_PRIMARY_PORT" "$ZT_SECONDARY_PORT" "$ZT_TERTIARY_PORT"; do
		printf '%s\n' "$ports" | grep -qx "$expected_port" || return 1
	done
}

sync_live_bypass_set() {
	bypass_set_elements="$1"
	command -v nft >/dev/null 2>&1 || return 0
	nft list set inet fw4 podkop_zerotier_udp_ports >/dev/null 2>&1 || return 0
	nft_batch="/tmp/zrs-bypass-live.$$"
	cat > "$nft_batch" <<EOF
flush set inet fw4 podkop_zerotier_udp_ports
add element inet fw4 podkop_zerotier_udp_ports { $bypass_set_elements }
EOF
	if ! nft -c -f "$nft_batch" || ! nft -f "$nft_batch"; then
		rm -f "$nft_batch"
		echo "Не удалось синхронизировать активные порты обхода ZeroTier." >&2
		return 1
	fi
	rm -f "$nft_batch"
}

ensure_transport_independence() {
	if [ ! -s "$ZT_LOCAL_CONF_TEMPLATE" ] || [ ! -s "$ZT_BYPASS_TEMPLATE" ]; then
		echo "Не найдены шаблоны защиты транспорта ZeroTier. Повторите установку панели." >&2
		return 1
	fi

	mkdir -p /etc/nftables.d
	bypass_ports="$ZT_PRIMARY_PORT $ZT_SECONDARY_PORT $ZT_TERTIARY_PORT"
	for runtime_port in $(current_zerotier_ports); do
		case "$runtime_port" in
			''|*[!0-9]*) continue ;;
		esac
		[ "$runtime_port" -ge 1 ] 2>/dev/null && [ "$runtime_port" -le 65535 ] 2>/dev/null || continue
		case " $bypass_ports " in
			*" $runtime_port "*) ;;
			*) bypass_ports="$bypass_ports $runtime_port" ;;
		esac
	done
	bypass_elements="$(printf '%s' "$bypass_ports" | sed 's/[[:space:]][[:space:]]*/, /g')"
	nft_candidate="/tmp/zrs-bypass-candidate.$$"
	sed "s/^[[:space:]]*elements = {.*}/\telements = { $bypass_elements }/" "$ZT_BYPASS_TEMPLATE" > "$nft_candidate"

	nft_changed=0
	if [ ! -f "$ZT_BYPASS_FILE" ] || ! cmp -s "$nft_candidate" "$ZT_BYPASS_FILE"; then
		nft_previous="/tmp/zrs-bypass-previous.$$"
		[ -f "$ZT_BYPASS_FILE" ] && cp -p "$ZT_BYPASS_FILE" "$nft_previous" || true
		cp "$nft_candidate" "${ZT_BYPASS_FILE}.new"
		chmod 0644 "${ZT_BYPASS_FILE}.new"
		mv "${ZT_BYPASS_FILE}.new" "$ZT_BYPASS_FILE"
		nft_changed=1
	fi
	rm -f "$nft_candidate"

	current_local_conf="$(uci -q get zerotier.global.local_conf_path 2>/dev/null || true)"
	[ -n "$current_local_conf" ] || current_local_conf="$ZT_SUPPORT_LOCAL_CONF"
	if [ "$current_local_conf" = "$ZT_SUPPORT_LOCAL_CONF" ] && [ ! -f "$current_local_conf" ]; then
			cp "$ZT_LOCAL_CONF_TEMPLATE" "${ZT_SUPPORT_LOCAL_CONF}.new"
			chmod 0600 "${ZT_SUPPORT_LOCAL_CONF}.new"
			mv "${ZT_SUPPORT_LOCAL_CONF}.new" "$ZT_SUPPORT_LOCAL_CONF"
	fi
	# Merge even our own configuration: it may contain user exclusions and keys.
	if ! cmp -s "$ZT_LOCAL_CONF_TEMPLATE" "$current_local_conf" || command -v jq >/dev/null 2>&1; then
		if [ ! -f "$current_local_conf" ]; then
			echo "Указанный ZeroTier local.conf не найден: $current_local_conf" >&2
			return 1
		fi
		if ! command -v jq >/dev/null 2>&1; then
			echo "Существующий ZeroTier local.conf сохранен. Для безопасного объединения настроек нужен jq." >&2
			return 1
		fi
		merged_conf="/tmp/zrs-local-conf-merged.$$"
		warp_interface="$(uci -q get warp.main.actual_interface 2>/dev/null || true)"
		if ! printf '%s' "$warp_interface" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]{0,14}$' ||
			[ "$(uci -q get "network.$warp_interface.warp_managed" 2>/dev/null || true)" != luci-app-warp ]; then
			warp_interface=''
		fi
		if ! merge_local_conf "$current_local_conf" "$warp_interface" > "$merged_conf"; then
			rm -f "$merged_conf"
			return 1
		fi
		jq -e ".settings.secondaryPort == $ZT_SECONDARY_PORT and .settings.tertiaryPort == $ZT_TERTIARY_PORT" "$merged_conf" >/dev/null || return 1
		if ! cmp -s "$merged_conf" "$current_local_conf"; then
			[ -e "${current_local_conf}.zrs-before-transport" ] || cp -p "$current_local_conf" "${current_local_conf}.zrs-before-transport"
			chmod --reference="$current_local_conf" "$merged_conf" 2>/dev/null || chmod 0600 "$merged_conf"
			mv "$merged_conf" "$current_local_conf"
		else
			rm -f "$merged_conf"
		fi
	fi

	uci set zerotier.global=zerotier
	uci set zerotier.global.port=9993
	uci set "zerotier.global.local_conf_path=${current_local_conf}"
	uci commit zerotier

	if [ "$nft_changed" = 1 ] && command -v fw4 >/dev/null 2>&1 && command -v nft >/dev/null 2>&1; then
		if ! fw4 print > /tmp/zrs-fw4-candidate.nft || ! nft -c -f /tmp/zrs-fw4-candidate.nft; then
			if [ -f "${nft_previous:-}" ]; then
				mv "$nft_previous" "$ZT_BYPASS_FILE"
			else
				rm -f "$ZT_BYPASS_FILE"
			fi
			echo "Правило независимого транспорта ZeroTier не прошло проверку firewall." >&2
			return 1
		fi
		rm -f "${nft_previous:-}"
		if ! /etc/init.d/firewall reload; then
			/etc/init.d/firewall restart || return 1
		fi
	fi
	if command -v nft >/dev/null 2>&1; then
		sync_live_bypass_set "$bypass_elements" || return 1
	fi

	echo "Защита транспорта ZeroTier активна: UDP $ZT_PRIMARY_PORT/$ZT_SECONDARY_PORT/$ZT_TERTIARY_PORT обходят перехват Podkop."
}

ensure_firewall() {
	if ! uci -q get "firewall.${FW_ZONE}" >/dev/null; then
		uci set "firewall.${FW_ZONE}=zone"
	fi

	uci set "firewall.${FW_ZONE}.name=${FW_ZONE}"
	uci -q delete "firewall.${FW_ZONE}.network" || true
	uci -q delete "firewall.${FW_ZONE}.device" || true
	uci add_list "firewall.${FW_ZONE}.device=zt+"
	uci set "firewall.${FW_ZONE}.input=REJECT"
	uci set "firewall.${FW_ZONE}.output=ACCEPT"
	uci set "firewall.${FW_ZONE}.forward=REJECT"

	if ! uci -q get "firewall.${FW_RULE}" >/dev/null; then
		uci set "firewall.${FW_RULE}=rule"
	fi

	uci set "firewall.${FW_RULE}.name=Allow-ZeroTier-Support-To-Router"
	uci set "firewall.${FW_RULE}.src=${FW_ZONE}"
	uci set "firewall.${FW_RULE}.proto=tcp"
	uci -q delete "firewall.${FW_RULE}.dest_port" || true
	uci add_list "firewall.${FW_RULE}.dest_port=22"
	uci add_list "firewall.${FW_RULE}.dest_port=80"
	uci add_list "firewall.${FW_RULE}.dest_port=443"
	uci set "firewall.${FW_RULE}.target=ACCEPT"

	if command -v fw4 >/dev/null 2>&1; then
		if ! fw4 check; then
			echo "Настройки firewall не прошли проверку fw4." >&2
			return 1
		fi
	fi

	uci commit firewall || return 1
	if ! /etc/init.d/firewall reload; then
		/etc/init.d/firewall restart || return 1
	fi
	if [ -n "${bypass_elements:-}" ] && command -v nft >/dev/null 2>&1; then
		sync_live_bypass_set "$bypass_elements" || return 1
	fi
}

snapshot_transport_state() {
	ZT_UPGRADE_SNAPSHOT="/tmp/zrs-transport-rollback.$$"
	mkdir -p "$ZT_UPGRADE_SNAPSHOT"
	cp -p /etc/config/zerotier "$ZT_UPGRADE_SNAPSHOT/zerotier.uci"
	cp -p /etc/config/firewall "$ZT_UPGRADE_SNAPSHOT/firewall.uci"
	old_local_conf="$(uci -q get zerotier.global.local_conf_path 2>/dev/null || true)"
	printf '%s\n' "$old_local_conf" > "$ZT_UPGRADE_SNAPSHOT/local-conf-path"
	if [ -n "$old_local_conf" ] && [ -f "$old_local_conf" ]; then
		cp -p "$old_local_conf" "$ZT_UPGRADE_SNAPSHOT/local-conf"
	fi
	[ -f "$ZT_SUPPORT_LOCAL_CONF" ] && cp -p "$ZT_SUPPORT_LOCAL_CONF" "$ZT_UPGRADE_SNAPSHOT/support-local-conf" || true
	[ -f "$ZT_BYPASS_FILE" ] && cp -p "$ZT_BYPASS_FILE" "$ZT_UPGRADE_SNAPSHOT/bypass.nft" || true

	ZT_UPGRADE_NETWORK_IDS="$(configured_network_ids | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
	ZT_UPGRADE_WAS_READY=0
	if zerotier-cli info 2>/dev/null | grep -q ' ONLINE$' && networks_are_ready "$ZT_UPGRADE_NETWORK_IDS"; then
		ZT_UPGRADE_WAS_READY=1
	fi
}

restore_snapshot_file() {
	backup_name="$1"
	target_path="$2"
	if [ -f "$ZT_UPGRADE_SNAPSHOT/$backup_name" ]; then
		cp -p "$ZT_UPGRADE_SNAPSHOT/$backup_name" "$target_path"
	else
		rm -f "$target_path"
	fi
}

restore_transport_snapshot() {
	[ -n "$ZT_UPGRADE_SNAPSHOT" ] && [ -d "$ZT_UPGRADE_SNAPSHOT" ] || return 1
	cp -p "$ZT_UPGRADE_SNAPSHOT/zerotier.uci" /etc/config/zerotier
	cp -p "$ZT_UPGRADE_SNAPSHOT/firewall.uci" /etc/config/firewall
	old_local_conf="$(cat "$ZT_UPGRADE_SNAPSHOT/local-conf-path")"
	if [ -n "$old_local_conf" ] && [ -f "$ZT_UPGRADE_SNAPSHOT/local-conf" ]; then
		cp -p "$ZT_UPGRADE_SNAPSHOT/local-conf" "$old_local_conf"
	fi
	restore_snapshot_file support-local-conf "$ZT_SUPPORT_LOCAL_CONF"
	restore_snapshot_file bypass.nft "$ZT_BYPASS_FILE"
	/etc/init.d/firewall reload || /etc/init.d/firewall restart
}

cleanup_transport_snapshot() {
	[ -n "$ZT_UPGRADE_SNAPSHOT" ] && [ -d "$ZT_UPGRADE_SNAPSHOT" ] || return 0
	rm -f "$ZT_UPGRADE_SNAPSHOT/zerotier.uci" \
		"$ZT_UPGRADE_SNAPSHOT/firewall.uci" \
		"$ZT_UPGRADE_SNAPSHOT/local-conf-path" \
		"$ZT_UPGRADE_SNAPSHOT/local-conf" \
		"$ZT_UPGRADE_SNAPSHOT/support-local-conf" \
		"$ZT_UPGRADE_SNAPSHOT/bypass.nft"
	rmdir "$ZT_UPGRADE_SNAPSHOT" 2>/dev/null || true
	ZT_UPGRADE_SNAPSHOT=""
}

transport_restart_required() {
	[ "$ZT_UPGRADE_WAS_READY" = 1 ] || return 1
	[ "${ZRS_FORCE_ZEROTIER_RESTART:-0}" = 1 ] && return 0
	transport_ports_are_fixed && return 1
	return 0
}

wait_for_zerotier_ready() {
	wait_attempt=0
	while [ "$wait_attempt" -lt 45 ]; do
		if zerotier-cli info 2>/dev/null | grep -q ' ONLINE$' && networks_are_ready "$ZT_UPGRADE_NETWORK_IDS"; then
			return 0
		fi
		wait_attempt=$((wait_attempt + 1))
		sleep 1
	done
	return 1
}

restart_and_verify_transport() {
	if ! /etc/init.d/zerotier restart; then
		echo "Служба ZeroTier не перезапустилась; требуется автоматический откат." >&2
		return 1
	fi
	if ! wait_for_zerotier_ready; then
		echo "ZeroTier не вернулся в исходные виртуальные сети; требуется автоматический откат." >&2
		return 1
	fi
	if ! transport_ports_are_fixed; then
		echo "ZeroTier вернулся, но постоянные порты не применились; требуется автоматический откат." >&2
		return 1
	fi
	ensure_transport_independence || return 1
	wait_for_zerotier_ready
}

install_or_upgrade() {
	pm_install_zerotier
	snapshot_transport_state
	if ! ensure_transport_independence || ! ensure_firewall; then
		echo "Обновление не применилось; выполняется автоматический откат." >&2
		restore_transport_snapshot || true
		cleanup_transport_snapshot
		return 1
	fi

	if transport_restart_required; then
		echo "Применяю обновление ZeroTier без перезагрузки роутера..."
		if ! restart_and_verify_transport; then
			echo "Восстанавливаю прежний транспорт и существующие виртуальные сети." >&2
			restore_transport_snapshot || true
			/etc/init.d/zerotier restart || true
			wait_for_zerotier_ready || true
			cleanup_transport_snapshot
			return 1
		fi
		echo "ZeroTier вернулся в существующие виртуальные сети; обновление завершено."
	elif [ "$ZT_UPGRADE_WAS_READY" = 1 ]; then
		echo "ZeroTier уже использует защищенные постоянные порты; перезапуск не требуется."
	else
		echo "Настройки установлены без перезапуска: активной готовой сети ZeroTier до обновления не было."
	fi

	cleanup_transport_snapshot
	status
}

configure_network() {
	network_id="$1"

	if ! is_hex16 "$network_id"; then
		echo "Неверный Network ID. Нужно 16 символов HEX, например 0123456789abcdef." >&2
		return 2
	fi

	pm_install_zerotier

	uci set zerotier.global=zerotier
	uci set zerotier.global.enabled='1'
	uci -q delete zerotier.earth || true
	uci -q delete "zerotier.${NETWORK_SECTION}" || true
	uci set "zerotier.${NETWORK_SECTION}=network"
	uci set "zerotier.${NETWORK_SECTION}.id=${network_id}"
	uci set "zerotier.${NETWORK_SECTION}.allow_managed=1"
	uci set "zerotier.${NETWORK_SECTION}.allow_global=0"
	uci set "zerotier.${NETWORK_SECTION}.allow_default=0"
	uci set "zerotier.${NETWORK_SECTION}.allow_dns=0"
	ensure_transport_independence
	ensure_firewall

	/etc/init.d/zerotier enable
	/etc/init.d/zerotier restart
	sleep 5

	status
}

leave_network() {
	network_id="${1:-$(uci -q get "zerotier.${NETWORK_SECTION}.id" || true)}"
	if [ -n "$network_id" ] && command -v zerotier-cli >/dev/null 2>&1; then
		zerotier-cli leave "$network_id" || true
	fi

	uci -q delete "zerotier.${NETWORK_SECTION}" || true
	uci commit zerotier
	ensure_transport_independence
	/etc/init.d/zerotier restart || true
	status
}

disable_service() {
	uci set zerotier.global=zerotier
	uci set zerotier.global.enabled='0'
	uci commit zerotier
	/etc/init.d/zerotier stop || true
	status
}

restart_service() {
	ensure_transport_independence
	/etc/init.d/zerotier restart
	sleep 5
	status
}

yn() {
	case "$1" in
		1|yes|true|on|enabled|OK) printf 'да' ;;
		0|no|false|off|disabled|'') printf 'нет' ;;
		*) printf '%s' "$1" ;;
	esac
}

value_or_dash() {
	if [ -n "${1:-}" ]; then
		printf '%s' "$1"
	else
		printf '-'
	fi
}

network_status_ru() {
	case "${1:-}" in
		OK) printf 'подключена' ;;
		ACCESS_DENIED) printf 'не авторизована в ZeroTier Central' ;;
		REQUESTING_CONFIGURATION) printf 'ждет авторизации или выдачи IP' ;;
		NOT_FOUND) printf 'сеть не найдена' ;;
		PORT_ERROR) printf 'ошибка UDP-порта ZeroTier' ;;
		*) value_or_dash "${1:-}" ;;
	esac
}

client_status_ru() {
	case "${1:-}" in
		ONLINE) printf 'в сети' ;;
		OFFLINE) printf 'не в сети' ;;
		*) value_or_dash "${1:-}" ;;
	esac
}

network_type_ru() {
	case "${1:-}" in
		PRIVATE) printf 'приватная' ;;
		PUBLIC) printf 'публичная' ;;
		*) value_or_dash "${1:-}" ;;
	esac
}

policy_ru() {
	case "${1:-}" in
		ACCEPT) printf 'разрешено' ;;
		REJECT) printf 'запрещено' ;;
		DROP) printf 'сбрасывается' ;;
		*) value_or_dash "${1:-}" ;;
	esac
}

collect_state() {
	zt_installed=0
	zt_service_enabled=0
	zt_running=0
	zt_info=''
	zt_networks=''
	zt_networks_json=''
	zt_peers=''
	zt_node='-'
	zt_version='-'
	zt_state='-'
	network_id="$(uci -q get "zerotier.${NETWORK_SECTION}.id" 2>/dev/null || true)"
	network_name='-'
	network_status='-'
	network_type='-'
	zt_device='-'
	zt_ips='-'
	peer_count=0
	direct_peer_count=0

	command -v zerotier-cli >/dev/null 2>&1 && zt_installed=1
	/etc/init.d/zerotier enabled >/dev/null 2>&1 && zt_service_enabled=1 || true
	pidof zerotier-one >/dev/null 2>&1 && zt_running=1 || true

	if [ "$zt_installed" = 1 ]; then
		zt_info="$(zerotier-cli info 2>&1 || true)"
		zt_networks="$(zerotier-cli listnetworks 2>&1 || true)"
		zt_networks_json="$(zerotier-cli listnetworks -j 2>/dev/null || true)"
		zt_peers="$(zerotier-cli listpeers 2>&1 || true)"

		zt_node="$(printf '%s\n' "$zt_info" | awk '/^200 info / {print $3; exit}')"
		zt_version="$(printf '%s\n' "$zt_info" | awk '/^200 info / {print $4; exit}')"
		zt_state="$(printf '%s\n' "$zt_info" | awk '/^200 info / {print $5; exit}')"
		[ -n "$zt_node" ] || zt_node='-'
		[ -n "$zt_version" ] || zt_version='-'
		[ -n "$zt_state" ] || zt_state='-'

		if [ -z "$network_id" ] && [ -n "$zt_networks_json" ]; then
			network_id="$(printf '%s\n' "$zt_networks_json" | jsonfilter -e '@[0].id' 2>/dev/null || true)"
		fi

		if [ -n "$network_id" ] && [ -n "$zt_networks_json" ]; then
			network_json_path="@[@.id=\"${network_id}\"]"
			network_name="$(printf '%s\n' "$zt_networks_json" | jsonfilter -e "${network_json_path}.name" 2>/dev/null || true)"
			network_status="$(printf '%s\n' "$zt_networks_json" | jsonfilter -e "${network_json_path}.status" 2>/dev/null || true)"
			network_type="$(printf '%s\n' "$zt_networks_json" | jsonfilter -e "${network_json_path}.type" 2>/dev/null || true)"
			zt_device="$(printf '%s\n' "$zt_networks_json" | jsonfilter -e "${network_json_path}.portDeviceName" 2>/dev/null || true)"
			zt_ips="$(printf '%s\n' "$zt_networks_json" | jsonfilter -e "${network_json_path}.assignedAddresses[*]" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//' || true)"
			[ -n "$network_name" ] || network_name='-'
			[ -n "$network_status" ] || network_status='-'
			[ -n "$network_type" ] || network_type='-'
			[ -n "$zt_device" ] || zt_device='-'
			[ -n "$zt_ips" ] || zt_ips='-'
		fi

		peer_count="$(printf '%s\n' "$zt_peers" | awk '$2 == "listpeers" && $3 != "<ztaddr>" {count++} END {print count + 0}')"
		direct_peer_count="$(printf '%s\n' "$zt_peers" | awk '$2 == "listpeers" && $3 != "<ztaddr>" && $4 != "-" {count++} END {print count + 0}')"
	fi

	allow_managed="$(uci -q get "zerotier.${NETWORK_SECTION}.allow_managed" 2>/dev/null || true)"
	allow_global="$(uci -q get "zerotier.${NETWORK_SECTION}.allow_global" 2>/dev/null || true)"
	allow_default="$(uci -q get "zerotier.${NETWORK_SECTION}.allow_default" 2>/dev/null || true)"
	allow_dns="$(uci -q get "zerotier.${NETWORK_SECTION}.allow_dns" 2>/dev/null || true)"

	fw_input="$(uci -q get "firewall.${FW_ZONE}.input" 2>/dev/null || true)"
	fw_forward="$(uci -q get "firewall.${FW_ZONE}.forward" 2>/dev/null || true)"
	fw_output="$(uci -q get "firewall.${FW_ZONE}.output" 2>/dev/null || true)"
	fw_device="$(uci -q get "firewall.${FW_ZONE}.device" 2>/dev/null || true)"
	fw_ports="$(uci -q get "firewall.${FW_RULE}.dest_port" 2>/dev/null || true)"
	fw_target="$(uci -q get "firewall.${FW_RULE}.target" 2>/dev/null || true)"

	zt_forwarding_found=0
	for section in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=forwarding$/\1/p'); do
		src="$(uci -q get "firewall.${section}.src" 2>/dev/null || true)"
		[ "$src" = "$FW_ZONE" ] && zt_forwarding_found=1
	done

	default_route_zt=0
	ip route show default 2>/dev/null | grep -Eq ' dev zt[a-zA-Z0-9]+' && default_route_zt=1 || true

	podkop_sources="$(uci -q get podkop.settings.source_network_interfaces 2>/dev/null || true)"
	podkop_output="$(uci -q get podkop.settings.enable_output_network_interface 2>/dev/null || true)"
	zt_transport_ports="$(current_zerotier_ports | tr '\n' ' ' | sed 's/[[:space:]]*$//' || true)"
	[ -n "$zt_transport_ports" ] || zt_transport_ports='-'
	zt_bypass_active=0
	[ -f "$ZT_BYPASS_FILE" ] && nft list chain inet fw4 podkop_zerotier_bypass >/dev/null 2>&1 && zt_bypass_active=1 || true
	zt_ports_protected=0
	if [ "$zt_transport_ports" != '-' ]; then
		zt_ports_protected=1
		zt_bypass_set="$(nft list set inet fw4 podkop_zerotier_udp_ports 2>/dev/null || true)"
		for runtime_port in $zt_transport_ports; do
			printf '%s\n' "$zt_bypass_set" | grep -Eq "(^|[,{[:space:]])${runtime_port}([,}[:space:]]|$)" || zt_ports_protected=0
		done
	fi
	podkop_bypass_return=0
	if ! nft list table inet PodkopTable >/dev/null 2>&1; then
		podkop_bypass_return=1
	elif nft list chain inet PodkopTable mangle_output 2>/dev/null | grep -q 'meta mark 0x00200000.*return'; then
		podkop_bypass_return=1
	fi
	zt_transport_independent=0
	[ "$zt_ports_protected" = 1 ] && [ "$zt_bypass_active" = 1 ] && [ "$podkop_bypass_return" = 1 ] && zt_transport_independent=1 || true
}

overall_state() {
	if [ "$zt_installed" != 1 ]; then
		printf 'ZeroTier не установлен'
	elif [ "$zt_running" != 1 ]; then
		printf 'служба ZeroTier не запущена'
	elif [ "$zt_state" != ONLINE ]; then
		printf 'ZeroTier не в сети: %s' "$zt_state"
	elif [ -z "$network_id" ]; then
		printf 'Network ID не задан'
	elif [ "$network_status" = ACCESS_DENIED ] || [ "$network_status" = REQUESTING_CONFIGURATION ]; then
		printf 'роутер ждет авторизации в ZeroTier Central'
	elif [ "$network_status" != OK ]; then
		printf 'сеть ZeroTier не готова: %s' "$network_status"
	elif [ "$zt_ips" = '-' ]; then
		printf 'сеть подключена, но IP еще не выдан'
	else
		printf 'работает, можно подключаться по ZeroTier IP'
	fi
}

next_action() {
	if [ "$zt_installed" != 1 ]; then
		printf 'нажмите "Установить / починить"'
	elif [ "$zt_running" != 1 ]; then
		printf 'нажмите "Перезапустить ZeroTier"'
	elif [ -z "$network_id" ]; then
		printf 'введите Network ID и нажмите "Подключить / сохранить"'
	elif [ "$network_status" = ACCESS_DENIED ] || [ "$network_status" = REQUESTING_CONFIGURATION ]; then
		printf 'откройте ZeroTier Central, авторизуйте этот роутер и обновите статус'
	elif [ "$zt_ips" != '-' ]; then
		printf 'подключайтесь: ssh root@%s или откройте http://%s/cgi-bin/luci/' "$(printf '%s' "$zt_ips" | cut -d/ -f1)" "$(printf '%s' "$zt_ips" | cut -d/ -f1)"
	else
		printf 'подождите 10-30 секунд и обновите статус'
	fi
}

print_friendly_report() {
	zt_ip_plain="$(printf '%s' "$zt_ips" | cut -d/ -f1)"
	[ "$zt_ips" = '-' ] && zt_ip_plain='-'

	echo "== Краткий итог =="
	printf 'Состояние: %s\n' "$(overall_state)"
	printf 'Что сделать: %s\n' "$(next_action)"

	echo
	echo "== Подключение ZeroTier =="
	printf 'ZeroTier установлен: %s\n' "$(yn "$zt_installed")"
	printf 'Автозапуск службы: %s\n' "$(yn "$zt_service_enabled")"
	printf 'Процесс запущен: %s\n' "$(yn "$zt_running")"
	printf 'Статус клиента: %s\n' "$(client_status_ru "$zt_state")"
	printf 'Версия ZeroTier: %s\n' "$(value_or_dash "$zt_version")"
	printf 'Node ID роутера: %s\n' "$(value_or_dash "$zt_node")"
	printf 'Network ID: %s\n' "$(value_or_dash "$network_id")"
	printf 'Название сети: %s\n' "$(value_or_dash "$network_name")"
	printf 'Статус сети: %s\n' "$(network_status_ru "$network_status")"
	printf 'Тип сети: %s\n' "$(network_type_ru "$network_type")"
	printf 'Интерфейс: %s\n' "$(value_or_dash "$zt_device")"
	printf 'ZeroTier IP: %s\n' "$(value_or_dash "$zt_ips")"
	printf 'Подключение для SSH: %s\n' "$([ "$zt_ip_plain" != '-' ] && printf 'ssh root@%s' "$zt_ip_plain" || printf '-')"
	printf 'Подключение для LuCI: %s\n' "$([ "$zt_ip_plain" != '-' ] && printf 'http://%s/cgi-bin/luci/' "$zt_ip_plain" || printf '-')"
	printf 'Пиры ZeroTier: всего %s, с прямым/активным путем %s\n' "$peer_count" "$direct_peer_count"

	echo
	echo "== Безопасность маршрутов =="
	printf 'Адреса из ZeroTier разрешены: %s\n' "$(yn "$allow_managed")"
	printf 'Глобальные маршруты из ZeroTier: %s\n' "$(yn "$allow_global")"
	printf 'Маршрут по умолчанию из ZeroTier: %s\n' "$(yn "$allow_default")"
	printf 'DNS из ZeroTier: %s\n' "$(yn "$allow_dns")"
	printf 'Основной маршрут через ZeroTier: %s\n' "$(yn "$default_route_zt")"
	if [ "$allow_global" = 0 ] && [ "$allow_default" = 0 ] && [ "$allow_dns" = 0 ] && [ "$default_route_zt" = 0 ]; then
		echo "Оценка: ZeroTier не должен перехватывать интернет-трафик роутера."
	else
		echo "Оценка: проверьте настройки, ZeroTier может влиять на маршрутизацию."
	fi

	echo
	echo "== Доступ к роутеру =="
	printf 'Firewall зона: %s\n' "$(value_or_dash "$FW_ZONE")"
	printf 'Устройства зоны: %s\n' "$(value_or_dash "$fw_device")"
	printf 'Политика входа из ZeroTier: %s\n' "$(policy_ru "$fw_input")"
	printf 'Политика выхода в ZeroTier: %s\n' "$(policy_ru "$fw_output")"
	printf 'Политика переадресации из ZeroTier: %s\n' "$(policy_ru "$fw_forward")"
	printf 'Проброс ZeroTier -> LAN/WAN найден: %s\n' "$(yn "$zt_forwarding_found")"
	printf 'Порты, открытые только к роутеру: %s\n' "$(value_or_dash "$fw_ports")"
	printf 'Правило доступа к SSH/LuCI активно: %s\n' "$([ "$fw_target" = ACCEPT ] && printf 'да' || printf 'нет')"

	echo
	echo "== Проверка podkop =="
	printf 'Интерфейсы podkop source: %s\n' "$(value_or_dash "$podkop_sources")"
	printf 'Маршрутизация исходящего трафика в podkop: %s\n' "$(yn "$podkop_output")"
	printf 'Постоянные UDP-порты ZeroTier: %s\n' "$(value_or_dash "$zt_transport_ports")"
	printf 'Обход перехвата Podkop активен: %s\n' "$(yn "$zt_bypass_active")"
	printf 'ZeroTier независим от состояния Podkop: %s\n' "$(yn "$zt_transport_independent")"
	if printf '%s\n' "$podkop_sources" | grep -Eq '(^|[[:space:]])zt'; then
		echo "Оценка: внимание, ZeroTier попал в source interfaces podkop."
	else
		echo "Оценка: ZeroTier не включен в source interfaces podkop."
	fi
}

print_technical_details() {
	echo
	echo "== Технические детали =="
	if [ "$zt_installed" = 1 ]; then
		echo "-- zerotier-cli info --"
		printf '%s\n' "$zt_info"
		echo
		echo "-- zerotier-cli listnetworks --"
		printf '%s\n' "$zt_networks"
	else
		echo "ZeroTier не установлен."
	fi

	echo
	echo "-- zerotier config без секрета --"
	uci -q show zerotier 2>/dev/null | sed "s/^zerotier\.global\.secret=.*/zerotier.global.secret='<hidden>'/" || true

	echo
	echo "-- zt interfaces --"
	ip addr show 2>/dev/null | sed -n '/zt/,+5p' || true

	echo
	echo "-- routes --"
	ip route show table main 2>/dev/null || true
	ip rule show 2>/dev/null || true

	echo
	echo "-- firewall --"
	uci -q show "firewall.${FW_ZONE}" || true
	uci -q show "firewall.${FW_RULE}" || true
}

status() {
	collect_state
	print_friendly_report
	print_technical_details
}

diagnose() {
	target="${1:-}"
	collect_state
	print_friendly_report

	if [ -n "$target" ]; then
		if ! is_safe_target "$target"; then
			echo
			echo "Неверная цель диагностики." >&2
			return 2
		fi

		echo
		echo "== Проверка связи =="
		echo "Цель: ${target}"
		if ping_out="$(ping -c 3 -W 2 "$target" 2>&1)"; then
			loss="$(printf '%s\n' "$ping_out" | sed -n 's/.* \([0-9.]*%\) packet loss.*/\1/p' | tail -1)"
			avg="$(printf '%s\n' "$ping_out" | sed -n 's/.*round-trip min\/avg\/max = [^/]*\/\([^/]*\)\/.*/\1 ms/p' | tail -1)"
			echo "Результат: ответ есть"
			[ -n "$loss" ] && echo "Потери: ${loss}"
			[ -n "$avg" ] && echo "Средняя задержка: ${avg}"
		else
			echo "Результат: ответа по ping нет"
			echo "Что это значит: цель недоступна или на ней запрещен ICMP. Для LuCI проверяйте адрес в браузере, для SSH - подключение к порту 22."
		fi
	fi

	echo
	echo "== Пиры ZeroTier =="
	if command -v zerotier-cli >/dev/null 2>&1; then
		zerotier-cli listpeers 2>&1 || true
	else
		echo "ZeroTier не установлен."
	fi

	print_technical_details
}

case "${1:-status}" in
	install)
		install_or_upgrade
		;;
	configure)
		configure_network "${2:-}"
		;;
	leave)
		leave_network "${2:-}"
		;;
	disable)
		disable_service
		;;
	restart)
		restart_service
		;;
	diagnose)
		diagnose "${2:-}"
		;;
	status)
		status
		;;
	*)
		echo "Usage: $0 {status|install|configure <network-id>|leave [network-id]|disable|restart|diagnose [target]}" >&2
		exit 2
		;;
esac
